{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w1ndys/easy-qfnu-kjs/schemas/manifest.schema.v1.json",
  "title": "数据清单 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "term",
    "generated_at",
    "anchor",
    "groups",
    "nodes",
    "statuses",
    "weeks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "term": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "week",
        "total_weeks",
        "timezone",
        "in_teaching_calendar"
      ],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "week": { "type": "integer", "minimum": 0 },
        "total_weeks": { "type": "integer", "minimum": 0 },
        "timezone": { "const": "Asia/Shanghai" },
        "in_teaching_calendar": { "type": "boolean" }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "room_count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "room_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "source_block"],
        "properties": {
          "code": { "type": "string", "pattern": "^(0[1-9]|1[0-2])$" },
          "source_block": { "type": "string", "pattern": "^\\d{4,6}$" }
        }
      }
    },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[1-9]$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "available"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "available": { "type": "boolean" }
          }
        }
      }
    },
    "weeks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]{1,2}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "week",
            "snapshot_id",
            "sha256",
            "generated_at",
            "last_success_at"
          ],
          "properties": {
            "week": { "type": "integer", "minimum": 1, "maximum": 30 },
            "snapshot_id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "generated_at": { "type": "string", "format": "date-time" },
            "last_success_at": { "type": "string", "format": "date-time" },
            "last_error_code": { "type": ["string", "null"] },
            "last_attempt_at": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    }
  }
}
