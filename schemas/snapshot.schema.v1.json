{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w1ndys/easy-qfnu-kjs/schemas/snapshot.schema.v1.json",
  "title": "周快照",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "term",
    "week",
    "snapshot_id",
    "generated_at",
    "last_success_at",
    "days"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "term": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d$" },
    "week": { "type": "integer", "minimum": 1, "maximum": 30 },
    "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generated_at": { "type": "string", "format": "date-time" },
    "last_success_at": { "type": "string", "format": "date-time" },
    "days": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 7,
      "patternProperties": {
        "^[1-7]$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rooms"],
          "properties": {
            "rooms": {
              "type": "array",
              "items": { "$ref": "#/$defs/room" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsbh", "group_id", "name", "statuses"],
      "properties": {
        "jsbh": { "type": "string", "minLength": 1, "maxLength": 64 },
        "group_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(0[1-9]|1[0-2])$": { "type": "integer", "minimum": 1, "maximum": 9 }
          }
        }
      }
    }
  }
}
