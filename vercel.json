{
  "buildCommand": "cd web && npm ci && npm run build",
  "installCommand": "cd web && npm ci",
  "outputDirectory": "web/dist",
  "framework": null,
  "functions": {
    "api/v1/[...path].ts": {
      "maxDuration": 30,
      "regions": [
        "hkg1"
      ],
      "includeFiles": [
        "data/**",
        "api-lib/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
