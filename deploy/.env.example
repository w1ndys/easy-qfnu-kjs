# 本机 Compose 与本地开发的变量样例：复制成 deploy/.env 再填真实值，不要提交 .env。
# 部署级变量清单以 docs/config/env.example 为准，业务设置（教务账号、飞书、OCR、cron）走 WebUI。

# PostgreSQL 容器自身的初始化参数
POSTGRES_USER=kjs
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=kjs

# 采集器、查询服务、面板后端共用的连接串（对应容器映射出来的本机端口）
DATABASE_URL=postgres://kjs:请改成强密码@127.0.0.1:5432/kjs?sslmode=disable

# WebUI 管理员登录密码，用户名固定 admin
ADMIN_PASSWORD=请改成强密码

# 存储层集成测试用的库连接串（go test 时设置，通常与 DATABASE_URL 相同）
TEST_DATABASE_URL=postgres://kjs:请改成强密码@127.0.0.1:5432/kjs?sslmode=disable
