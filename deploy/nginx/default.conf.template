# web 容器的站点配置模板。镜像里落 /etc/nginx/templates/default.conf.template，
# 官方 nginx entrypoint 的 20-envsubst-on-templates.sh 用环境变量把它渲染成
# /etc/nginx/conf.d/default.conf（同名覆盖镜像自带的默认站点）：只替换
# BACKEND_UPSTREAM，nginx 自身的 $uri、$host、$remote_addr、$scheme 不在环境变量
# 名单里，保持原样。
#
# 拓扑：本容器是唯一对宿主暴露端口的入口，静态产物、SPA 兜底与三条反代都在这里；
# server 只在内网 18080 上监听。反代上游用变量形式配 Docker 内嵌 DNS 按请求解析，
# 这样 server 重建换 IP 后不必重启 web。
#
# 排错：容器起不来先看 `docker compose logs web`（nginx -t 的报错会打在这里）。

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # nginx 的 301（目录缺尾斜杠、/api → /api/ 这类自动补斜杠）默认写绝对 URL，端口取
    # 容器内监听端口；宿主侧端口是 compose 的 SERVER_PORT（可以不是 8080，smoke 用
    # 18081），绝对 URL 会把用户导到错端口。改成相对 Location，由浏览器补当前地址。
    absolute_redirect off;

    # 变量形式的 proxy_pass 必须配 resolver：否则 nginx 只在启动时解析一次上游，
    # server 换 IP 后 web 会一直 502 到被手工重启（design「web 容器与 nginx 反代」
    # 第 4 条）。127.0.0.11 是 Docker 内嵌 DNS，valid=10s 让 IP 变化快速生效，
    # ipv6=off 省掉无用的 AAAA 查询。
    resolver 127.0.0.11 valid=10s ipv6=off;

    # 上游地址由模板渲染注入（BACKEND_UPSTREAM，格式 host:port，不带协议）。
    # 这里故意不加引号：留空时渲染成 `set $backend ;`，nginx -t 因参数个数不对
    # 直接失败——空上游不允许起容器（design 第 1 条）。配错地址则是运行期 502。
    set $backend ${BACKEND_UPSTREAM};

    # 上游刚被停掉/重建时，resolver 的旧 IP 还在缓存里（valid=10s），连一个已消失的
    # 地址会重试到默认 60s 的 connect 超时，用户侧看到的是首个请求卡三四十秒才等到
    # 502；连接超时压到 2s 让它快速失败。读超时显式写 30s（默认 60s），慢接口的
    # 等待上限收敛在这一条上。
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;

    # 这两个头挂到所有响应（静态、兜底、反代）上。
    # 注意 nginx 的 add_header 继承规则：某个 location 里只要出现一条 add_header，
    # 就不再继承 server 级的；所以下面自带 add_header 的 location 都重复了这两条。
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # 压缩是纯加法：text/html 默认就在压缩范围里，这里补上其余三类静态产物与 JSON。
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    # 压缩是按 Accept-Encoding 协商的：没有 Vary 时中间缓存可能把 gzip 版本发给不
    # 支持的客户端（或缓存未压缩版本再发给支持的客户端）。gzip_vary 让 nginx 补
    # Vary: Accept-Encoding。
    gzip_vary on;

    # 哈希资源：文件名含内容哈希，可以长缓存；未命中要 404 而不是兜 index.html，
    # 否则浏览器会把 HTML 当 JS 解析（design 第 2 条）。
    # 长缓存这条不加 always：404 不挂一年期缓存头，免得一次部署竞态里的缺文件
    # 被浏览器记上一整年（安全头仍然 always，错误响应也要带）。
    location ^~ /assets/ {
        try_files $uri =404;

        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    # 管理端 HTML 不落任何缓存。兜底时把 index.html 当「文件」直接送出
    # （try_files 的 /index.html 后面还跟着 =404，所以它是候选文件而不是内部跳转
    # 目标）——走内部跳转的话，本段的 no-store 会被 /index.html 那段的头盖掉。
    location ^~ /admin {
        try_files $uri $uri/ /index.html =404;

        add_header Cache-Control "no-cache, no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options SAMEORIGIN always;
    }

    # index.html 与 SPA 兜底：每次都要回源校验（发版后资源文件名变了，缓存住旧 HTML
    # 会白屏）。location / 的兜底会内部跳转到这里，直接访问 /index.html 也走这段。
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options SAMEORIGIN always;
    }

    # 基础镜像自带 50x.html 已从镜像里删掉（Dockerfile.web 的 runtime 阶段）。这里再
    # 显式 404：否则该路径会命中 location / 的 SPA 兜底，返回 200 的 index.html——
    # 一个不属于本站的资源不该以「页面能打开」的形式存在。
    location = /50x.html {
        return 404;
    }

    # /api/ 前缀反代：用 ^~ 保证带点的路径（如 /api/export.json）不会落到静态兜底；
    # 带点的非 /api 路径也不会被这段截走（CP8）。
    location ^~ /api/ {
        proxy_pass http://$backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 后端取 X-Forwarded-For 的最右一跳，proxy_add_x_forwarded_for 把真实客户端
        # 地址追加在最后，与 TRUST_PROXY_HEADERS=true 配对成立（design 第 5 条）。
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 探针也走反代：宿主侧 deploy:health 要复验就绪状态，缺这两条就只能进容器查。
    # 探针只认精确路径（=），带尾斜杠的变体由下面两条显式 404 堵掉。
    location = /healthz {
        proxy_pass http://$backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /readyz {
        proxy_pass http://$backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 带尾斜杠的探针路径不匹配上面的 = 精确段，会落到 location / 的 SPA 兜底返回
    # 200 HTML——监控把路径拼成 /healthz/ 时也「看起来通了」。显式 404，让错路径
    # 立刻暴露（design 第 2 条）。
    location = /healthz/ {
        return 404;
    }

    location = /readyz/ {
        return 404;
    }

    # 其余一律静态：命中文件/目录就送出，否则兜 index.html 交给前端路由
    # （/screen、/day/:roomId 这类前端路径由前端接管）。兜底是内部跳转到
    # = /index.html，所以 no-cache 由那一段给出。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
