# easy-qfnu-kjs 环境变量样例。复制成 .env 后改真实值：cp .env.example .env
# .env 被 .gitignore 忽略；真实口令、密钥只写在 .env，本文件只留默认值或空占位。
#
# 文件分两段，顺序固定为「应用配置在前、编排变量在后」：
#   1. 应用配置：与 backend/internal/config 的 config.Config 逐字段对应，共 8 项
#      （本项先只落编排段，应用段由 tasklist 第 4 项补齐）；
#   2. 编排变量：只被 deploy/compose.yaml 与 deploy/nginx/default.conf.template 读取，
#      不进入应用进程环境。
#
# 在仓库根自检：
#   POSTGRES_PASSWORD=ci-placeholder docker compose -f deploy/compose.yaml --env-file .env.example config -q
# shell 环境变量优先于 --env-file，所以占位口令不必写进本文件。

# --- 编排变量（仅 deploy/compose.yaml 与 nginx 模板使用，不进入应用进程）---

# 数据库用户，默认 kjs。同时用于 postgres 初始化与 server 的 DATABASE_URL 拼接。
# 改了它不会改已有数据卷里的角色：旧卷要么 down -v 重建，要么在库里手工建角色。
POSTGRES_USER=kjs

# 数据库口令，必填、无默认值：留空或删掉这一行时 compose 直接拒绝部署并指名这个变量。
# 取值限定字母、数字与 - _：DATABASE_URL 由 compose 直接插值拼出，口令里带 @ : / 这类
# 字符会把连接串拆坏。确实需要强随机符号口令时，改为在 .env 里显式写完整的 DATABASE_URL。
POSTGRES_PASSWORD=

# 数据库名，默认 easy_qfnu_kjs。同样只在首次初始化数据卷时生效。
POSTGRES_DB=easy_qfnu_kjs

# web 端口在宿主上的绑定地址，默认 127.0.0.1（只听本机回环）。
# 校内其他机器要访问时改 0.0.0.0——这是把服务暴露到内网的唯一开关。
BIND_ADDR=127.0.0.1

# web 在宿主上的端口，默认 8080（映射到容器内 nginx 的 8080）。
# server 不占宿主端口，永远只在 compose 内网的 18080 上。
SERVER_PORT=8080

# web 反代的上游，默认 server:18080，格式 host:port、不带协议。
# 只被 nginx 模板渲染进 proxy_pass：填错是运行期 502；留空则 nginx -t 失败、容器起不来。
BACKEND_UPSTREAM=server:18080

# web 与 server 两个镜像共用的 tag，默认 local。
# 镜像回退时把它回填成上一个可用 tag，再用 task deploy:rollback 成对换回。
IMAGE_TAG=local

# 备份保留天数，默认 7，传给 backup 服务的 BACKUP_RETAIN_DAYS（每天一次备份，
# 7 天即「当天 + 最近 7 天」）。备份脚本属 tasklist 第 5 项。
BACKUP_RETAIN_DAYS=7
