# 教务系统教师账号（采集器使用，本地 cron 从本文件读取；禁止提交）
QFNU_USERNAME=
QFNU_PASSWORD=

# 验证码本地离线识别命令（默认 scripts/ocr_ddddocr.py，依赖 Python ddddocr：
# pip install ddddocr；也支持任意读图片路径参数或 stdin 并输出文本的本地 CLI）
# OCR_CMD=scripts/ocr_ddddocr.py

# 可选：飞书自定义机器人告警（加签模式）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 可选：采集器运行/发布相关
# COLLECTOR_STATE_DIR=~/.local/state/easy-qfnu-kjs
# PUBLISH_REPO=w1ndys/easy-qfnu-kjs
