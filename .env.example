# 教务系统教师账号（采集器使用，本地 cron 从本文件读取；禁止提交）
QFNU_USERNAME=
QFNU_PASSWORD=

# 验证码本地离线识别命令（无网络 OCR；使用 uv 管理的全局虚拟环境）：
#   uv venv ~/.local/share/easy-qfnu-ocr-venv --python 3.12
#   uv pip install --python ~/.local/share/easy-qfnu-ocr-venv/bin/python ddddocr
# 图片路径会被自动追加为命令最后一个参数；也可用任意读文件/stdin 的本地 CLI。
OCR_CMD=/home/w1ndys/.local/share/easy-qfnu-ocr-venv/bin/python scripts/ocr_ddddocr.py

# 可选：飞书自定义机器人告警（加签模式）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 可选：采集器运行/发布相关
# COLLECTOR_STATE_DIR=~/.local/state/easy-qfnu-kjs
# DATABASE_URL=postgres://kjs:PASSWORD@127.0.0.1:5432/kjs?sslmode=disable
# 只有指到本机服务时才做 HTTP 验收，公网域名仍是旧服务时会跳过
# PUBLISH_BASE_URL=http://127.0.0.1:8080
