# easy-qfnu-kjs 环境变量样例。复制成 .env 后改真实值：cp .env.example .env
# .env 被 .gitignore 忽略；真实口令、密钥只写在 .env，本文件只留默认值或空占位。
#
# 文件分两段，顺序固定为「应用配置在前、编排变量在后」：
#   1. 应用配置：与 backend/internal/config 的 config.Config 逐字段对应，共 8 项；
#   2. 编排变量：只被 deploy/compose.yaml 与 deploy/nginx/default.conf.template 读取，
#      不进入应用进程环境。
#
# 应用段的每项都标了默认值与适用场景；留空与不设置同义，server 按默认值启动
# （唯一例外是 DATABASE_URL，它必填）。
#
# 在仓库根自检：
#   POSTGRES_PASSWORD=ci-placeholder docker compose -f deploy/compose.yaml --env-file .env.example config -q
# shell 环境变量优先于 --env-file，所以占位口令不必写进本文件。

# --- 应用配置（与 backend/internal/config 逐字段对应，共 8 项）---

# PostgreSQL 连接串，必填、无默认值：留空或删掉这行时 server 启动直接失败（报错点名这个变量）。
# 必须以 postgres:// 或 postgresql:// 开头，否则启动期就被拒，不会拖到连库时才暴露。
# 走 compose 时保持空即可：server 的 DATABASE_URL 由编排段的 POSTGRES_* 拼出，不在这里重复写口令。
# 直接跑后端时填 postgres://用户:口令@主机:5432/库名（真实口令只写进 .env）。
DATABASE_URL=

# HTTP 监听地址，默认 :18080。
# 容器内固定用默认值：server 不映射宿主端口，宿主侧端口由编排段的 SERVER_PORT 决定、流量经 web 反代进来。
# 只有在宿主上绕过 web 直连 server 排障时，才改成 127.0.0.1:18080 这类只留本机的地址。
HTTP_ADDR=

# 日志级别，默认 info，可选 debug/info/warn/error（config.Load 强校验）。
# 取值拼错即启动失败，不静默回落到默认级别；排障时临时改 debug，复现完改回 info 以免日志刷屏。
LOG_LEVEL=

# OCR 请求超时，默认 10s；必须是正时长，写成 Go duration 形式（如 15s、1m）。
# 解析失败或零/负值都会启动失败；OCR 服务慢时可调大，但会等比拉长单轮采集的耗时上限。
OCR_TIMEOUT=

# 是否信任前置反代给出的来源头（X-Forwarded-For / X-Real-IP），默认 true。
# 经 web 反代时为 true：否则限流与统计看到的客户端 IP 全是 web 容器地址。
# 只有绕过反代、直连 server 排障时才 false（此时来源头由客户端自报，可被伪造）。
TRUST_PROXY_HEADERS=

# 加密密钥文件路径，默认 /var/lib/easy-qfnu-kjs/secret.key（命名卷内，文件由管理端初始化时写出）。
# 这里只写路径、不含密钥内容；改路径时要把旧密钥文件一起搬过去，否则已加密的设置项解不开。
SECRET_KEY_PATH=

# 管理会话 Cookie 是否带 Secure 属性。
# 内网 HTTP 阶段取 false：否则浏览器会丢弃管理会话 Cookie，登录看起来像没生效；
# TLS 终止之后取 true：Cookie 只在 HTTPS 下发送。
# 注意 config.Load 的进程默认值是 true，而 compose 对这项传的缺省值是 false（HTTP 阶段口径）：
# 走 compose 时内网阶段留空即可、切 TLS 后显式写 true；直接跑后端时内网阶段要显式写 false。
ADMIN_COOKIE_SECURE=

# 教务系统根地址，默认 http://zhjw.qfnu.edu.cn；只做非空透传，地址形状由 upstream.New 校验。
# 部署到内网、改走反代入口或带路径前缀时在这里换成实际地址（如 https://jw.example.edu.cn/jw）。
UPSTREAM_BASE_URL=

# --- 编排变量（仅 deploy/compose.yaml 与 nginx 模板使用，不进入应用进程）---

# 数据库用户，默认 kjs。同时用于 postgres 初始化与 server 的 DATABASE_URL 拼接。
# 改了它不会改已有数据卷里的角色：旧卷要么 down -v 重建，要么在库里手工建角色。
POSTGRES_USER=kjs

# 数据库口令，必填、无默认值：留空或删掉这一行时 compose 直接拒绝部署并指名这个变量。
# 取值限定字母、数字与 - _：DATABASE_URL 由 compose 直接插值拼出，口令里带 @ : / 这类
# 字符会把连接串拆坏。确实需要强随机符号口令时，改为在 .env 里显式写完整的 DATABASE_URL。
POSTGRES_PASSWORD=

# 数据库名，默认 easy_qfnu_kjs。同样只在首次初始化数据卷时生效。
POSTGRES_DB=easy_qfnu_kjs

# web 端口在宿主上的绑定地址，默认 127.0.0.1（只听本机回环）。
# 校内其他机器要访问时改 0.0.0.0——这是把服务暴露到内网的唯一开关。
BIND_ADDR=127.0.0.1

# web 在宿主上的端口，默认 8080（映射到容器内 nginx 的 8080）。
# server 不占宿主端口，永远只在 compose 内网的 18080 上。
SERVER_PORT=8080

# web 反代的上游，默认 server:18080，格式 host:port、不带协议。
# 只被 nginx 模板渲染进 proxy_pass：填错是运行期 502；留空则 nginx -t 失败、容器起不来。
BACKEND_UPSTREAM=server:18080

# web 与 server 两个镜像共用的 tag，默认 local。
# 镜像回退时把它回填成上一个可用 tag，再用 task deploy:rollback 成对换回。
IMAGE_TAG=local

# 备份保留天数，默认 7，传给 backup 服务的 BACKUP_RETAIN_DAYS（每天一次备份，
# 7 天即「当天 + 最近 7 天」）。备份脚本属 tasklist 第 5 项。
BACKUP_RETAIN_DAYS=7
